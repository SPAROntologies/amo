    <rdfs:comment xml:lang="en">A claim that is restricted by a rebuttal of an argument.</rdfs:comment>
    <vann:example>
    :my-claim a amo:Claim ;
        amo:isValidUnless :my-rebuttal .

    :my-rebuttal a amo:Rebuttal .
    </vann:example>
