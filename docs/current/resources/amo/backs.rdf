<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF
   xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
   xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
   xmlns:vann="http://purl.org/vocab/vann/"
   xmlns:vs="http://www.w3.org/2003/06/sw-vocab-status/ns#"
>
  <rdf:Description rdf:about="http://purl.org/spar/amo/backs">
    <rdfs:comment xml:lang="en">A backing that attests the warrant of an argument.</rdfs:comment>
    <rdfs:subPropertyOf rdf:resource="http://purl.org/spar/amo/relatesTo"/>
    <rdfs:subPropertyOf rdf:resource="http://purl.org/spar/cito/givesBackgroundTo"/>
    <rdfs:label xml:lang="en">backs</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="http://purl.org/spar/amo/"/>
    <rdfs:range rdf:resource="http://purl.org/spar/amo/Warrant"/>
    <vann:example>
    :my-backing a amo:Backing ;
        amo:backs :my-warrant .

    :my-warrant a amo:Warrant .
    </vann:example>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <vs:term_status rdf:resource="http://purl.org/linked-data/registry#statusStable"/>
    <rdfs:domain rdf:resource="http://purl.org/spar/amo/Backing"/>
  </rdf:Description>
</rdf:RDF>
