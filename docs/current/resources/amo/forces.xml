  <rdf:Description rdf:about="http://purl.org/spar/amo/forces">
    <rdfs:range rdf:resource="http://purl.org/spar/amo/Claim"/>
    <rdfs:comment xml:lang="en">A qualifier that expresses as degree of force concerning a claim of an argument.</rdfs:comment>
    <rdfs:label xml:lang="en">forces</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="http://purl.org/spar/amo/"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <vann:example>
    :my-qualifier a amo:Qualifier ;
        amo:forces :my-claim .

    :my-claim a amo:Claim .
    </vann:example>
    <rdfs:domain rdf:resource="http://purl.org/spar/amo/Qualifier"/>
    <skos:note xml:lang="en">By means of the property chain defined, the assertion that links a qualifier to the relative claim is automatically inferred starting from the high-level description of an argument (realized through the sub-properties of 'involves' and their inverse properties).</skos:note>
