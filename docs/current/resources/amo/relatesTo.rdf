  <rdf:Description rdf:nodeID="n1a0a3a68be7f463a92e2a2d38d5834b0b31">
    <rdf:rest rdf:nodeID="n1a0a3a68be7f463a92e2a2d38d5834b0b32"/>
    <rdf:first rdf:resource="http://purl.org/spar/amo/ArgumentationEntity"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/spar/amo/relatesTo">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
    <vs:term_status rdf:resource="http://purl.org/linked-data/registry#statusStable"/>
    <vann:example>
    :my-evidence a amo:Evidence ;
        amo:relatesTo :my-claim .

    :my-claim a amo:Claim .
    </vann:example>
    <rdfs:isDefinedBy rdf:resource="http://purl.org/spar/amo/"/>
    <rdfs:label xml:lang="en">relates to</rdfs:label>
    <rdfs:comment xml:lang="en">An argumentation entity relates to another one in some way - for example, it is the evidence that is used to prove a claim of an argument.</rdfs:comment>
    <rdfs:range rdf:resource="http://purl.org/spar/amo/ArgumentationEntity"/>
    <rdfs:domain rdf:nodeID="n1a0a3a68be7f463a92e2a2d38d5834b0b30"/>
  </rdf:Description>
