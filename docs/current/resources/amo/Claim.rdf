>
  <rdf:Description rdf:nodeID="n1a0a3a68be7f463a92e2a2d38d5834b0b28">
    <rdf:rest rdf:nodeID="n1a0a3a68be7f463a92e2a2d38d5834b0b29"/>
    <rdf:first rdf:resource="http://purl.org/spar/amo/ArgumentationEntity"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n1a0a3a68be7f463a92e2a2d38d5834b0b27">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="http://purl.org/spar/amo/isClaimIn"/>
    <owl:someValuesFrom rdf:resource="http://purl.org/spar/amo/Argument"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/spar/amo/Claim">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <owl:equivalentClass rdf:nodeID="n1a0a3a68be7f463a92e2a2d38d5834b0b26"/>
    <vs:term_status rdf:resource="http://purl.org/linked-data/registry#statusStable"/>
    <rdfs:isDefinedBy rdf:resource="http://purl.org/spar/amo/"/>
    <rdfs:label xml:lang="en">claim</rdfs:label>
    <vann:example>
    :my-claim a amo:Claim ;
        amo:isClaimIn :my-argument ;
        amo:isValidUnless :my-rebuttal .
    </vann:example>
    <rdfs:comment xml:lang="en">A fact that must be established - e.g., 'This is a consistent OWL ontology'.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n1a0a3a68be7f463a92e2a2d38d5834b0b29">
    <rdf:first rdf:nodeID="n1a0a3a68be7f463a92e2a2d38d5834b0b27"/>
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n1a0a3a68be7f463a92e2a2d38d5834b0b26">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <owl:intersectionOf rdf:nodeID="n1a0a3a68be7f463a92e2a2d38d5834b0b28"/>
  </rdf:Description>
