  <rdf:Description rdf:about="http://purl.org/spar/amo/ArgumentationEntity">
    <rdfs:comment xml:lang="en">An entity that takes part in an argument according to the 'Toulmin model of argument'.</rdfs:comment>
    <vann:example>
    :my-claim a amo:ArgumentationEntity ;
        amo:isInvolvedIn :my-argument .
    </vann:example>
    <rdfs:isDefinedBy rdf:resource="http://purl.org/spar/amo/"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <owl:equivalentClass rdf:nodeID="n1a0a3a68be7f463a92e2a2d38d5834b0b36"/>
    <vs:term_status rdf:resource="http://purl.org/linked-data/registry#statusStable"/>
    <rdfs:label xml:lang="en">argumentation entity</rdfs:label>
  </rdf:Description>
