<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF
   xmlns:owl="http://www.w3.org/2002/07/owl#"
   xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
   xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
   xmlns:vann="http://purl.org/vocab/vann/"
   xmlns:vs="http://www.w3.org/2003/06/sw-vocab-status/ns#"
>
  <rdf:Description rdf:about="http://purl.org/spar/amo/Qualifier">
    <vann:example>
    :my-qualifier a amo:Qualifier ;
        amo:isQualifierIn :my-argument ;
        amo:forces :my-claim .
    </vann:example>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <owl:equivalentClass rdf:nodeID="n1a0a3a68be7f463a92e2a2d38d5834b0b21"/>
    <vs:term_status rdf:resource="http://purl.org/linked-data/registry#statusStable"/>
    <rdfs:comment xml:lang="en">Words or phrases that express the degree of certainty of the claim such as “certainly”, “possible”, “probably”, “presumably”, etc.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://purl.org/spar/amo/"/>
    <rdfs:label xml:lang="en">qualifier</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n1a0a3a68be7f463a92e2a2d38d5834b0b21">
    <owl:someValuesFrom rdf:resource="http://purl.org/spar/amo/Argument"/>
    <owl:onProperty rdf:resource="http://purl.org/spar/amo/isQualifierIn"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
  </rdf:Description>
</rdf:RDF>
