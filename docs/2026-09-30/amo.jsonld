      "http://www.w3.org/2002/07/owl#SymmetricProperty"
    ],
    "http://purl.org/vocab/vann/example": [
      {
        "@value": "\n    :my-evidence a amo:Evidence ;\n        amo:relatesTo :my-claim .\n\n    :my-claim a amo:Claim .\n    "
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "An argumentation entity relates to another one in some way - for example, it is the evidence that is used to prove a claim of an argument."
      }
    ],
