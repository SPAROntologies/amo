    "http://purl.org/vocab/vann/example": [
      {
        "@value": "\n    :my-backing a amo:Backing ;\n        amo:backs :my-warrant .\n\n    :my-warrant a amo:Warrant .\n    "
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "A backing that attests the warrant of an argument."
