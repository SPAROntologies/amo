<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF
   xmlns:owl="http://www.w3.org/2002/07/owl#"
   xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
   xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
   xmlns:vann="http://purl.org/vocab/vann/"
   xmlns:vs="http://www.w3.org/2003/06/sw-vocab-status/ns#"
>
  <rdf:Description rdf:about="http://purl.org/spar/amo/isInvolvedIn">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <vs:term_status rdf:resource="http://purl.org/linked-data/registry#statusStable"/>
    <rdfs:comment xml:lang="en">An argumentation entity involved in the presentation of an argument.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://purl.org/spar/amo/"/>
    <owl:inverseOf rdf:resource="http://purl.org/spar/amo/involves"/>
    <vann:example>
    :my-claim 
        amo:isInvolvedIn :my-argument .

    :my-argument a amo:Argument .
    </vann:example>
    <rdfs:label xml:lang="en">is involved in</rdfs:label>
  </rdf:Description>
</rdf:RDF>
