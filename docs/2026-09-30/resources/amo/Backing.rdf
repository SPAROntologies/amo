  <rdf:Description rdf:about="http://purl.org/spar/amo/Backing">
    <vs:term_status rdf:resource="http://purl.org/linked-data/registry#statusStable"/>
    <vann:example>
    :my-backing a amo:Backing ;
        amo:isBackingIn :my-argument ;
        amo:backs :my-warrant .
    </vann:example>
    <owl:equivalentClass rdf:nodeID="n1a0a3a68be7f463a92e2a2d38d5834b0b9"/>
    <rdfs:comment xml:lang="en">Sort of credentials that certifies the warrant - e.g., the OWL 2 document specifications.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://purl.org/spar/amo/"/>
    <rdfs:label xml:lang="en">backing</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
