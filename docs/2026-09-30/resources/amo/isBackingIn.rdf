  <rdf:Description rdf:about="http://purl.org/spar/amo/isBackingIn">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <vs:term_status rdf:resource="http://purl.org/linked-data/registry#statusStable"/>
    <rdfs:comment xml:lang="en">An argumentative entity linked to an argument in which it is considered a backing.</rdfs:comment>
    <rdfs:label xml:lang="en">is backing in</rdfs:label>
    <owl:inverseOf rdf:resource="http://purl.org/spar/amo/hasBacking"/>
    <rdfs:isDefinedBy rdf:resource="http://purl.org/spar/amo/"/>
    <rdfs:subPropertyOf rdf:resource="http://purl.org/spar/amo/isInvolvedIn"/>
    <vann:example>
    :my-backing 
        amo:isBackingIn :my-argument .

    :my-argument a amo:Argument .
    </vann:example>
  </rdf:Description>
