[
  {
    "@id": "http://purl.org/spar/amo/proves",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://purl.org/vocab/vann/example": [
      {
        "@value": "\n    :my-evidence a amo:Evidence ;\n        amo:proves :my-claim .\n\n    :my-claim a amo:Claim .\n    "
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "An evidence that founds a claim of an argument."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "http://purl.org/spar/amo/Evidence"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "http://purl.org/spar/amo/"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "proves"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://purl.org/spar/amo/Claim"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subPropertyOf": [
      {
        "@id": "http://purl.org/spar/amo/relatesTo"
      },
      {
        "@id": "http://purl.org/spar/cito/isCitedAsEvidenceBy"
      }
    ],
    "http://www.w3.org/2002/07/owl#propertyChainAxiom": [
      {
        "@list": [
          {
            "@id": "http://purl.org/spar/amo/isEvidenceIn"
          },
          {
            "@id": "http://purl.org/spar/amo/hasClaim"
          }
        ]
      }
    ],
    "http://www.w3.org/2003/06/sw-vocab-status/ns#term_status": [
      {
        "@id": "http://purl.org/linked-data/registry#statusStable"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@language": "en",
        "@value": "By means of the property chain defined, the assertion that links an evidence to the relative claim is automatically inferred starting from the high-level description of an argument (realized through the sub-properties of 'involves' and their inverse properties)."
      }
    ]
  }
]