<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF
   xmlns:owl="http://www.w3.org/2002/07/owl#"
   xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
   xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
   xmlns:vann="http://purl.org/vocab/vann/"
   xmlns:vs="http://www.w3.org/2003/06/sw-vocab-status/ns#"
>
  <rdf:Description rdf:about="http://purl.org/spar/amo/Evidence">
    <owl:equivalentClass rdf:nodeID="n1a0a3a68be7f463a92e2a2d38d5834b0b17"/>
    <rdfs:label xml:lang="en">evidence</rdfs:label>
    <rdfs:comment xml:lang="en">A fact that represents a foundation for the claim - e.g., 'This ontology was developed in OWL'.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <vann:example>
    :my-evidence a amo:Evidence ;
        amo:isEvidenceIn :my-argument ;
        amo:proves :my-claim .
    </vann:example>
    <rdfs:isDefinedBy rdf:resource="http://purl.org/spar/amo/"/>
    <vs:term_status rdf:resource="http://purl.org/linked-data/registry#statusStable"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n1a0a3a68be7f463a92e2a2d38d5834b0b17">
    <owl:intersectionOf rdf:nodeID="n1a0a3a68be7f463a92e2a2d38d5834b0b19"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n1a0a3a68be7f463a92e2a2d38d5834b0b18">
    <owl:onProperty rdf:resource="http://purl.org/spar/amo/isEvidenceIn"/>
    <owl:someValuesFrom rdf:resource="http://purl.org/spar/amo/Argument"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n1a0a3a68be7f463a92e2a2d38d5834b0b20">
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
    <rdf:first rdf:nodeID="n1a0a3a68be7f463a92e2a2d38d5834b0b18"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n1a0a3a68be7f463a92e2a2d38d5834b0b19">
    <rdf:first rdf:resource="http://purl.org/spar/amo/ArgumentationEntity"/>
    <rdf:rest rdf:nodeID="n1a0a3a68be7f463a92e2a2d38d5834b0b20"/>
  </rdf:Description>
</rdf:RDF>
