  <rdf:Description rdf:about="http://purl.org/spar/amo/proves">
    <rdfs:domain rdf:resource="http://purl.org/spar/amo/Evidence"/>
    <rdfs:comment xml:lang="en">An evidence that founds a claim of an argument.</rdfs:comment>
    <rdfs:subPropertyOf rdf:resource="http://purl.org/spar/cito/isCitedAsEvidenceBy"/>
    <rdfs:subPropertyOf rdf:resource="http://purl.org/spar/amo/relatesTo"/>
    <rdfs:label xml:lang="en">proves</rdfs:label>
    <owl:propertyChainAxiom rdf:nodeID="nac206eba9ad849d79fa50974ed88d668b7"/>
    <vann:example>
    :my-evidence a amo:Evidence ;
        amo:proves :my-claim .

    :my-claim a amo:Claim .
    </vann:example>
    <rdfs:range rdf:resource="http://purl.org/spar/amo/Claim"/>
    <vs:term_status rdf:resource="http://purl.org/linked-data/registry#statusStable"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:isDefinedBy rdf:resource="http://purl.org/spar/amo/"/>
    <skos:note xml:lang="en">By means of the property chain defined, the assertion that links an evidence to the relative claim is automatically inferred starting from the high-level description of an argument (realized through the sub-properties of 'involves' and their inverse properties).</skos:note>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nac206eba9ad849d79fa50974ed88d668b7">
    <rdf:rest rdf:nodeID="nac206eba9ad849d79fa50974ed88d668b8"/>
    <rdf:first rdf:resource="http://purl.org/spar/amo/isEvidenceIn"/>
