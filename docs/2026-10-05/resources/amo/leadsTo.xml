>
  <rdf:Description rdf:nodeID="nac206eba9ad849d79fa50974ed88d668b5">
    <rdf:first rdf:resource="http://purl.org/spar/amo/isWarrantIn"/>
    <rdf:rest rdf:nodeID="nac206eba9ad849d79fa50974ed88d668b6"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/spar/amo/leadsTo">
    <owl:propertyChainAxiom rdf:nodeID="nac206eba9ad849d79fa50974ed88d668b5"/>
    <skos:note xml:lang="en">A warrant that points to a claim from the related evidence within an argument.</skos:note>
    <skos:note xml:lang="en">By means of the property chain defined, the assertion that links a warrant to the relative claim is automatically inferred starting from the high-level description of an argument (realized through the sub-properties of 'involves' and their inverse properties).</skos:note>
    <rdfs:domain rdf:resource="http://purl.org/spar/amo/Warrant"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:isDefinedBy rdf:resource="http://purl.org/spar/amo/"/>
    <rdfs:label xml:lang="en">leads to</rdfs:label>
    <rdfs:subPropertyOf rdf:resource="http://purl.org/spar/amo/relatesTo"/>
    <rdfs:subPropertyOf rdf:resource="http://purl.org/spar/cito/confirms"/>
    <rdfs:range rdf:resource="http://purl.org/spar/amo/Claim"/>
    <vann:example>
    :my-warrant a amo:Warrant ;
        amo:leadsTo :my-claim .

    :my-claim a amo:Claim .</vann:example>
    <vs:term_status rdf:resource="http://purl.org/linked-data/registry#statusStable"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nac206eba9ad849d79fa50974ed88d668b6">
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
    <rdf:first rdf:resource="http://purl.org/spar/amo/hasClaim"/>
  </rdf:Description>
</rdf:RDF>
