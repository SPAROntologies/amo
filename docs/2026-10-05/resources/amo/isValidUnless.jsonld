[
  {
    "@id": "http://purl.org/spar/amo/isValidUnless",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://purl.org/vocab/vann/example": [
      {
        "@value": "\n    :my-claim a amo:Claim ;\n        amo:isValidUnless :my-rebuttal .\n\n    :my-rebuttal a amo:Rebuttal .\n    "
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "A claim that is restricted by a rebuttal of an argument."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "http://purl.org/spar/amo/Claim"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "http://purl.org/spar/amo/"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "is valid unless"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://purl.org/spar/amo/Rebuttal"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subPropertyOf": [
      {
        "@id": "http://purl.org/spar/cito/isDisputedBy"
      },
      {
        "@id": "http://purl.org/spar/amo/relatesTo"
      }
    ],
    "http://www.w3.org/2002/07/owl#propertyChainAxiom": [
      {
        "@list": [
          {
            "@id": "http://purl.org/spar/amo/isClaimIn"
          },
          {
            "@id": "http://purl.org/spar/amo/hasRebuttal"
          }
        ]
      }
    ],
    "http://www.w3.org/2003/06/sw-vocab-status/ns#term_status": [
      {
        "@id": "http://purl.org/linked-data/registry#statusStable"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@language": "en",
        "@value": "By means of the property chain defined, the assertion that links a claim to the relative rebuttal is automatically inferred starting from the high-level description of an argument (realized through the sub-properties of 'involves' and their inverse properties)."
      }
    ]
  }
]